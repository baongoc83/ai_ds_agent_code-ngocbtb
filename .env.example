# Copy this file to .env and fill in the values you need.
#
# Two backends are supported (pick one — controlled by LLM_BACKEND):
#   LLM_BACKEND=legacy  (default)  → LiteLLM proxy + OpenAI/Claude fallback (vars below)
#   LLM_BACKEND=gateway            → single LiteLLM gateway via Anthropic API (vars at bottom)
LLM_BACKEND=legacy

# ─────────────────────────────────────────────────────────────────────────────
# LEGACY BACKEND vars (used when LLM_BACKEND=legacy)
# ─────────────────────────────────────────────────────────────────────────────
# At least ONE of the three LLM endpoints (proxy / OpenAI / Claude) must be set.

# ── LiteLLM Proxy (recommended primary) ──────────────────────────────────────
# Start with:  litellm --config config.yaml   (see start_litellm.ps1)
LITELLM_URL=http://localhost:4000
API_KEY=anything

# Model names as defined in config.yaml
LOCAL_MODEL=local-model
CLOUD_MODEL=cloud-model

# Prompts longer than this (chars) are routed to CLOUD_MODEL
MODEL_ROUTING_THRESHOLD=6000

# ── Direct OpenAI Fallback (optional) ────────────────────────────────────────
# Used when the LiteLLM proxy is unreachable.
OPENAI_API_KEY=
OPENAI_DIRECT_MODEL=gpt-4.1-mini

# ── Direct Claude Fallback (optional, last resort) ───────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_DIRECT_MODEL=claude-sonnet-4-6

# ── LLM Behaviour ────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_MAX_TOKENS_LARGE=4000
LLM_TOP_P=0.95
LLM_FREQUENCY_PENALTY=0.1
LLM_PRESENCE_PENALTY=0.0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=2.0
TIMEOUT=60
# Uncomment to fix seed for reproducible LLM outputs
# LLM_SEED=42

# ─────────────────────────────────────────────────────────────────────────────
# GATEWAY BACKEND vars (used when LLM_BACKEND=gateway)
# ─────────────────────────────────────────────────────────────────────────────
# Single LiteLLM gateway that speaks the Anthropic API. The gateway internally
# routes each tier alias (Haiku/Sonnet/Opus) to the actual underlying model.
# No application-level fallback — the gateway handles failover itself.

# Bearer token + endpoint
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=http://localhost:4000

# Per-request timeout (milliseconds). 3_000_000 = 50 min — long agent runs.
API_TIMEOUT_MS=3000000

# Model tier aliases that the gateway recognises
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4-7

# Routing strategy across the 3 tiers:
#   low    = always Haiku
#   medium = Haiku for short prompts, Sonnet for long  (default)
#   high   = Sonnet for short prompts, Opus for long
EFFORT_LEVEL=medium

# ─────────────────────────────────────────────────────────────────────────────
# Output / Logging
# ─────────────────────────────────────────────────────────────────────────────
# All persisted artifacts go to OUTPUT_DIR/<YYYY-MM-DD>/run_<NN>/
# run_NN counter resets when day rolls over (new day folder starts fresh).
OUTPUT_DIR=outputs

# When true, clean_*.parquet / engineered_*.parquet intermediate handoff files
# are kept in run_NN/ alongside reports. When false (default), they go to a
# system tempdir and are deleted at pipeline end (saves disk on production runs).
# KEEP_INTERMEDIATES=false

# Pipeline raises at Stage 0 if OUTPUT_DIR's filesystem has less than this many
# GB free. Prevents mid-run write failures on production batch jobs.
# MIN_DISK_FREE_GB=2.0

# ── S3 / S3-compatible storage (optional) ────────────────────────────────────
# Used when input path starts with s3://
# Leave empty to use AWS default credential chain (env/aws cli/IAM role)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Override for S3-compatible endpoints (MinIO/Wasabi/...) — leave empty for AWS
S3_ENDPOINT_URL=
# Network timeouts (seconds) — bump for very large parquet datasets
S3_CONNECT_TIMEOUT=300
S3_REQUEST_TIMEOUT=3600

# ── Temporal split granularity ───────────────────────────────────────────────
# Granularity of OOT / valid_temporal / stability slices.
#   auto    (default) → monthly buckets; detects monthly_snapshot vs intra_month
#                       but NEVER infers weekly (avoids mis-detection).
#   weekly            → weekly buckets; opt in explicitly for a weekly model.
#   monthly           → force monthly.
# For weekly, the snapshot/cutoff weekday is auto-detected as the most common
# weekday in the date column unless WEEK_CLOSING_DAY is set (MON..SUN).
# Can also be overridden per-run: pipeline.run(..., temporal_freq="weekly",
# week_closing_day="FRI").
# TEMPORAL_FREQ=auto
# WEEK_CLOSING_DAY=

# ── Feature engineering ──────────────────────────────────────────────────────
# Master switch for Agent 2's interaction-feature step. Set to false to skip
# every `create_interaction` action (model learns only from original + encoded
# columns; IV/WoE/selection still run). Default true.
# FE_CREATE_INTERACTIONS_ENABLED=true

# IV stability train <-> valid/oot. After each holdout is transformed, Agent 2
# re-scores IV there using the bin edges frozen from train and compares. Catches
# what PSI cannot: a stable X-distribution whose relationship to the target
# weakens or reverses. Diagnostic only — nothing is dropped here.
# FE_IV_STABILITY_ENABLED=true
# FE_IV_STABILITY_MAX_DROP=0.30
# FE_IV_STABILITY_MIN_WOE_CORR=0.50
# FE_IV_STABILITY_MIN_BIN_COUNT=30
# FE_IV_STABILITY_TOP_N=20

# ── Model Training (override only if needed; full reference in docs/config_params.md) ──
# RANDOM_STATE=42
# CV_N_SPLITS=5
# FLAML_TIME_BUDGET=600
# OPTUNA_N_TRIALS=300
# OPTUNA_TIMEOUT=7200
# MAX_FINAL_FEATURES=200

# ── Auto-config from raw input (DEFAULT ON) ────────────────────────────────────
# At the start of every run the pipeline profiles the raw input (rows, columns,
# numeric/categorical mix) and auto-derives the feature-count caps and
# row-sampling sizes below when they are NOT pinned via env. This removes the
# need to hand-tune ~9 knobs per dataset size (e.g. ~1000 features / ~1M rows).
#
# Explicitly-set env vars ALWAYS win over auto-config, so only uncomment the
# ones you want to force; the rest keep their auto-derived values.
# Disable auto-config entirely with the CLI flag:  python main.py ... --no-auto-config
#
# Auto-managed knobs (values shown are the env vars to pin if you disagree):
# TOP_K_FEATURES_CAP          # set = total cols (let everything into selection)
# RFE_TARGET_FEATURES         # ~40% of cols, clamped 150–800
# MAX_FINAL_FEATURES          # ~25% of cols, clamped 100–300
# TARGET_NEW_FEATURE_COUNT    # ~4% of cols, clamped 15–60
# FEATURE_META_MAX_NUMERIC_COLS       # = numeric cols, clamped 300–1000
# FEATURE_META_MAX_CATEGORICAL_COLS   # = categorical cols, clamped 80–400
# FLAML_MAX_ROWS              # min(rows, 500K), floor 50K
# SHAP_SAMPLE_SIZE            # min(rows, 20K), floor 5K
# DRIFT_SAMPLE_N              # min(rows, 100K), floor 10K
#
# Example: force the final feature budget while letting the rest auto-derive:
# MAX_FINAL_FEATURES=150

# ── Multi-seed bagging (banking variance-reduction stack) ────────────────────
# Train MULTI_SEED_N copies with different random_state values and average
# predict_proba. +0.1-0.3% AUC and much more stable PD scores across retrains.
# Set MULTI_SEED_ENABLED=false to fall back to single-model legacy behaviour.
# MULTI_SEED_ENABLED=true
# MULTI_SEED_N=5

# ── Probability calibration (IFRS9 / scorecard PD) ───────────────────────────
# Wraps the final model with isotonic / sigmoid mapping fit on a valid split.
# AUC neutral-to-positive, big Brier-score improvement — required for IFRS9 ECL.
# CALIBRATION_ENABLED=true
# CALIBRATION_METHOD=isotonic  # 'isotonic' (default, banking standard) or 'sigmoid'

# ── SHAP final visual + LLM-explained top features ─────────────────────────
# After the final model is trained, Agent 3 computes SHAP importances on the
# deployed model, saves a bar plot, and calls the LLM to narrate the top N
# features (grounded in col_descriptions when provided). Set to "false" to skip
# the SHAP compute + LLM call on automated batch runs.
# SHAP_FINAL_EXPLAIN_ENABLED=true
# SHAP_FINAL_EXPLAIN_TOP_N=20

# ── Model diagnostic charts ──────────────────────────────────────────────────
# Quantile-bucket count for the Lift / Gain / Bad-rate / Avg-score charts and
# the calibration reliability plot. 10 = classic deciles. Raise (e.g. 20) for
# finer granularity on large eval splits; lower (e.g. 5) on small splits to
# avoid sparse/empty buckets.
# CHART_N_DECILES=10

# ── Parallel worker staging ──────────────────────────────────────────────────
# Where joblib serialises X_train for memmap workers. Default = system tempdir
# (/tmp on Linux, %TEMP% on Windows). Override only when /tmp is also small
# (e.g. very large datasets on a constrained host) — point at a disk-backed path
# with several GB free.
# JOBLIB_TEMP_FOLDER=/data/joblib_tmp

# ── Null processing (Stage 1b) ───────────────────────────────────────────────
# NULL_PROCESSOR_ENABLED=true        # false = skip the stage (legacy behaviour)
# NULL_PROCESSOR_USE_LLM=true        # false = heuristic rules only, no LLM call
# NULL_DRIFT_WARN_THRESHOLD=0.10     # warn if a partition's missing rate differs from train by > this
# NULL_SCALE_WARN_RATIO=3            # unit-change guard: batch magnitude vs train, warn at >= this factor
# NULL_SCALE_FAIL_RATIO=10           # ...critical when median AND p95 shift >= this (0 disables); batches < 100 rows not judged
# DATA_GUARD_ACTION=warn             # warn = keep going, list findings in data_quality_report.json + final_report.md
#                                    # fail = stop on a critical finding (thresholds are domain-specific)

# ── Feature ranking / pruning (Agent 3) ─────────────────────────────────────
# FEATURE_RANK_METHOD=importance     # importance (one fit, minutes) | rfe (legacy, hours)
# FEATURE_RANK_IMPORTANCE=gain       # gain | shap
# FEATURE_RANK_CORR_THRESHOLD=0.90   # drop near-duplicate candidates (keep the more important); 0 = off
# FEATURE_RANK_N_ESTIMATORS=500      # ranking / prune model trees (early stopping on valid)
# FEATURE_RANK_LEARNING_RATE=0.05    # learning-rate floor for those models
# PRUNE_METHOD=batch_tolerance       # batch_tolerance | one_by_one (legacy SHAP+PSI loop)
# PRUNE_BATCH_FRACTION=0.10          # share of weakest features removed per round
# PRUNE_AUC_TOLERANCE=0.001          # valid-AUC loss accepted for a smaller set (0 = never trade AUC)
# PRUNE_STOP_DROP=0.010              # stop shrinking once AUC is this far below the best
# PRUNE_MAX_ROUNDS=40
# FEATURE_CAP_POLICY=cap_first       # cap_first = guarantee <= MAX_FINAL_FEATURES | auc_first = soft cap
# MAX_FINAL_FEATURES=100
# OPTUNA_AFTER_SELECTION=true        # true = tune once on the final features; false = legacy (tune, prune, re-tune)
# OPTUNA_TRIAL_TIMEOUT=0             # per-trial wall-clock cap in seconds (0 = auto)
# OPTUNA_ENABLE_DART=false
# PRUNE_SMOOTH_WINDOW=3             # moving-average window on the AUC-vs-size curve (1 = raw)
# PRUNE_SE_MULTIPLIER=0.0            # widen tolerance to k x AUC standard error (0 = off)
# FINAL_ES_TREE_HEADROOM=2.0         # CV tree ceiling = tuned n_estimators x this (1 = legacy)

# ── On-prem / enterprise LLM (OpenAI-compatible) ─────────────────────────────
# The legacy backend speaks the OpenAI chat API, so any of these work as LITELLM_URL:
#   LiteLLM proxy / enterprise gateway : http://llm-gw.internal:4000
#   vLLM / SGLang served directly      : http://gpu-node:8000/v1      (note the /v1)
#   Ollama                             : http://ollama-host:11434/v1
# LOCAL_MODEL handles short prompts, CLOUD_MODEL long ones (MODEL_ROUTING_THRESHOLD chars).
# LLM_BACKEND=legacy
# LITELLM_URL=http://llm-gw.internal:4000
# API_KEY=<gateway or server key>
# LOCAL_MODEL=qwen3-8b
# CLOUD_MODEL=deepseek-v3            # or glm-4.5 / qwen3-235b-a22b ...
# LLM_ALLOW_EXTERNAL_FALLBACK=false  # on-prem: never call OpenAI / Anthropic directly
# LLM_SKIP_PROXY=false
# TIMEOUT=300                        # seconds per call; local models are slower than SaaS
# LLM_MAX_RETRIES=4
# LLM_MAX_TOKENS_LARGE=8000          # thinking models spend tokens before the JSON
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}   # Qwen3 on vLLM/SGLang
# LLM_STRIP_REASONING=true           # drop <think>…</think> before parsing
# LLM_JSON_MODE_NATIVE=true          # false if the server rejects response_format=json_object
# LLM_OMIT_PARAMS=                   # e.g. frequency_penalty,presence_penalty,seed
# Per-model rule: "param@match" drops a param only for models whose name contains
# `match` (case-insensitive); rules without '@' are global. Known model quirks
# (e.g. GLM rejecting `thinking` / `temperature`) are already baked into config.py
# (_MODEL_PARAM_RULES) — env rules are additive, so only add models not covered there.
# LLM_OMIT_PARAMS=thinking@ttcndl/GLM,temperature@ttcndl/GLM
# NO_PROXY=llm-gw.internal,gpu-node  # bypass the corporate HTTP proxy for internal endpoints
